{
  "name": "clinicos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:check": "node tools/db-check.mjs",
    "db:setup": "node tools/db-setup.mjs",
    "db:setup-pg": "node tools/apply-migrations-pg.mjs",
    "db:seed-prod": "node tools/seed-production.mjs",
    "db:test-connection": "node tools/test-db-connection.mjs",
    "rls:check": "node tools/rls-check.mjs",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy --warm-cache",
    "deploy:response-store": "cf deploy --prebuilt --mode production --worker clinicos-response-store"
  },
  "dependencies": {
    "@cloudflare/workers-response-store": "^1.2.0",
    "@electric-sql/pglite": "^0.3.16",
    "@node-rs/argon2": "^2.2.2",
    "@vercel/speed-insights": "^2.1.0",
    "@vinext/cloudflare": "^1.4.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "^19.3.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "vinext": "^1.4.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
