# ---------------------------------------------------------------------------
# ClinicOS · variáveis de ambiente
# ---------------------------------------------------------------------------

# Banco local (desenvolvimento): PGlite, sem configuração adicional.
# PGLITE_DATA_DIR=.data/clinicos

# Produção / PostgreSQL:
# DATABASE_URL=postgresql://clinicos_owner:senha@host:5432/clinicos
# APP_DATABASE_URL=postgresql://clinicos_app:senha@host:5432/clinicos
# DB_SET_ROLE=true

# Sessão (obrigatório em produção; mínimo 32 caracteres)
# AUTH_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres

# Pool de conexões
# DATABASE_POOL_MAX=10

NODE_ENV=development
