# ---------------------------------------------------------------------------
# ClinicOS · variáveis de ambiente
# ---------------------------------------------------------------------------

# Banco local (desenvolvimento): PGlite, sem configuração adicional.
# PGLITE_DATA_DIR=.data/clinicos

# Produção / PostgreSQL:
# DATABASE_URL=postgresql://clinicos_owner:senha@host:5432/clinicos?sslmode=require
# APP_DATABASE_URL=postgresql://clinicos_app:senha@host:5432/clinicos?sslmode=require
#
# Cloudflare (Hyperdrive):
# HYPERDRIVE é um binding definido em cloudflare.config.ts / wrangler.toml.
# A connection string é configurada no Hyperdrive (não em env vars).
# Para desenvolvimento local, use DB_SSL=true e DATABASE_URL apontando para Postgres local.
# DB_SET_ROLE=true
#
# SSL (Supabase / hosts com TLS obrigatório):
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false   # apenas se o certificado for autoassinado

# Sessão (obrigatório em produção; mínimo 32 caracteres)
# AUTH_SECRET=troque-por-uma-chave-aleatoria-de-32-caracteres

# Pool de conexões
# DATABASE_POOL_MAX=10

NODE_ENV=development
